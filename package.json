{
  "name": "mwgl-studio-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "validate:eval-dataset": "node scripts/validate-eval-dataset.js",
    "synthesize:dataset": "node scripts/synthesize-dataset.js",
    "merge:eval-datasets": "node scripts/merge-eval-datasets.js",
    "import:chat2workflow-dataset": "node scripts/import-chat2workflow-dataset.js",
