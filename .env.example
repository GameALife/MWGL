DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
PORT=3001
CORS_ORIGIN=*

# Top-4 优化第 1 轮起整图改写（束搜索 / MCTS 共用）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# RobustFlow 图编辑距离（节点/图级 F1），Top-2 打分默认混入；设为 0 可关闭
# MWGL_GRAPH_EDIT_EVAL=1
# MWGL_GRAPH_EDIT_WEIGHT=0.2
# ROBUSTFLOW_ROOT=/path/to/RobustFlow
# MWGL_GRAPH_EDIT_SENTENCE_MODEL=sentence-transformers/all-mpnet-base-v2
# MWGL_GRAPH_EDIT_LOCAL_FILES_ONLY=0
# MWGL_GRAPH_EDIT_TIMEOUT_MS=180000
# MWGL_PYTHON_BIN=python3

# 代码运行失败后 LLM 修复轮数（默认 2）
# MWGL_CODE_REPAIR_MAX_RETRY=2
# MWGL_GENERATE_MAX_RETRY=3
